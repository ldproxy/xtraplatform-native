{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "ldproxy/renovate-config:xtraplatform"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "native libraries downloaded in the Gradle build, marked with a renovate comment",
      "managerFilePatterns": ["/^xtraplatform-(proj|spatialite|xtralink)/[^/]+\\.gradle$/"],
      "matchStrings": [
        "// renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\s+\\w+ = '(?<currentValue>[^']+)'"
      ]
    }
  ],
  "customDatasources": {
    "sqlite": {
      "defaultRegistryUrlTemplate": "https://www.sqlite.org/download.html",
      "format": "plain"
    },
    "libspatialite": {
      "defaultRegistryUrlTemplate": "http://www.gaia-gis.it/gaia-sins/libspatialite-sources/",
      "format": "html"
    }
  },
  "packageRules": [
    {
      "matchPackageNames": ["madler/zlib", "libtiff/libtiff", "ldproxy/xtralink"],
      "extractVersion": "^v(?<version>.+)$"
    },
    {
      "matchPackageNames": ["libtiff/libtiff", "libgeos/geos"],
      "versioning": "regex:^v?(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)(?<prerelease>(rc|beta|alpha)\\d+)?$"
    },
    {
      "matchPackageNames": ["sqlite"],
      "extractVersion": "^PRODUCT,[^,]+,(?<version>\\d{4}/sqlite-autoconf-\\d+)\\.tar\\.gz,",
      "versioning": "regex:^(?<build>\\d{4})/sqlite-autoconf-(?<major>\\d)(?<minor>\\d{2})(?<patch>\\d{2})00$"
    },
    {
      "matchPackageNames": ["libspatialite"],
      "extractVersion": "^libspatialite-(?<version>.+)\\.tar\\.gz$",
      "versioning": "regex:^(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)(-(?<prerelease>RC\\d+))?$"
    }
  ]
}
